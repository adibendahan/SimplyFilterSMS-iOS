default_platform(:ios)

platform :ios do

  def api_key
    app_store_connect_api_key(
      key_id: "25D6M24FR5",
      issuer_id: "1ce4be2f-095e-46f8-9565-6893ad621877",
      key_filepath: "~/.appstoreconnect/private_keys/AuthKey_25D6M24FR5.p8"
    )
  end

  desc "Take iPhone screenshots"
  lane :iphone_screenshots do
    capture_screenshots(
      devices: ["iPhone 17 Pro Max (26.1)"],
      languages: ["he-IL", "ar", "de", "es", "pt-BR", "fr", "it", "ja", "ko", "zh-Hans", "en-US"],
      scheme: "UI Tests",
      project: "Simply Filter SMS.xcodeproj",
      output_directory: ".screenshots",
      clear_previous_screenshots: false,
      override_status_bar: true,
      localize_simulator: true,
      number_of_retries: 0,
      stop_after_first_error: true,
      concurrent_simulators: true
    )
  end

  desc "Take iPad screenshots"
  lane :ipad_screenshots do
    capture_screenshots(
      devices: ["iPad Pro 13-inch (M5) (26.1)"],
      languages: ["he-IL", "ar", "de", "es", "pt-BR", "fr", "it", "ja", "ko", "zh-Hans", "en-US"],
      scheme: "UI Tests",
      project: "Simply Filter SMS.xcodeproj",
      output_directory: ".screenshots",
      clear_previous_screenshots: false,
      override_status_bar: true,
      localize_simulator: true,
      number_of_retries: 0,
      stop_after_first_error: true,
      concurrent_simulators: true
    )
  end

  desc "Take all screenshots (iPhone + iPad)"
  lane :screenshots do
    iphone_screenshots
    ipad_screenshots
  end

  desc "Take Simplified Chinese screenshots only (iPhone + iPad)"
  lane :zh_hans_screenshots do
    capture_screenshots(
      devices: ["iPhone 17 Pro Max", "iPad Pro 13-inch (M5)"],
      languages: ["zh-Hans"],
      scheme: "UI Tests",
      project: "Simply Filter SMS.xcodeproj",
      output_directory: ".screenshots",
      clear_previous_screenshots: false,
      override_status_bar: true,
      localize_simulator: true,
      number_of_retries: 0,
      stop_after_first_error: true,
      concurrent_simulators: true
    )
  end

  desc "Upload screenshots to App Store Connect"
  lane :upload_screenshots do
    # Rename locale folders to App Store Connect locale codes
    {
      "ar" => "ar-SA",
      "de" => "de-DE",
      "en" => "en-US",
      "es" => "es-ES",
      "fr" => "fr-FR",
      "pt" => "pt-BR",
      "zh" => "zh-Hans"
    }.each do |from, to|
      src = File.join(Dir.pwd, "..", ".screenshots", from)
      dst = File.join(Dir.pwd, "..", ".screenshots", to)
      File.rename(src, dst) if File.directory?(src)
    end

    upload_to_app_store(
      api_key: api_key,
      screenshots_path: ".screenshots",
      skip_metadata: true,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Download existing metadata from App Store Connect"
  lane :download_metadata do
    upload_to_app_store(
      api_key: api_key,
      metadata_path: "fastlane/metadata",
      skip_screenshots: true,
      skip_binary_upload: true,
      download_only: true
    )
  end

  desc "Upload metadata to App Store Connect"
  lane :upload_metadata do
    upload_to_app_store(
      api_key: api_key,
      metadata_path: "fastlane/metadata",
      skip_screenshots: true,
      skip_binary_upload: true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload creative assets (fastlane/creative_assets/*.png, or files:a.png,b.png) to the App Asset Library"
  lane :upload_creative_assets do |options|
    api_key
    client = Spaceship::ConnectAPI.client.tunes_request_client
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    UI.user_error!("App not found") unless app

    library_id = client.get("v1/apps/#{app.id}/assetLibrary").body["data"]["id"]

    existing_names = client.get("v1/appAssetLibraries/#{library_id}/images", { limit: 200 })
      .all_pages
      .flat_map { |page| page.body["data"] }
      .reject { |image| image["attributes"]["state"] == "FAILED" }
      .map { |image| image["attributes"]["fileName"] }

    assets_folder = File.join(FastlaneCore::FastlaneFolder.path, "creative_assets")
    paths = Dir[File.join(assets_folder, "*.png")].sort
    if options[:files]
      requested = options[:files].split(",").map(&:strip)
      paths = paths.select { |path| requested.include?(File.basename(path)) }
      UI.user_error!("No matching files in #{assets_folder}") if paths.empty?
    end

    uploaded_ids = {}
    paths.each do |path|
      file_name = File.basename(path)
      if existing_names.include?(file_name)
        UI.important("Skipping #{file_name}: already in the library")
        next
      end

      bytes = File.binread(path)
      reservation = client.post("v1/appAssetLibraryImages", {
        data: {
          type: "appAssetLibraryImages",
          attributes: {
            fileName: file_name,
            fileSize: bytes.bytesize,
            category: "CREATIVE_ASSETS",
            referenceName: File.basename(path, ".png")
          },
          relationships: {
            assetLibrary: { data: { type: "appAssetLibraries", id: library_id } }
          }
        }
      }).body["data"]

      Spaceship::ConnectAPI::FileUploader.upload(reservation["attributes"]["uploadOperations"], bytes)
      client.patch("v1/appAssetLibraryImages/#{reservation['id']}", {
        data: { type: "appAssetLibraryImages", id: reservation["id"], attributes: { uploaded: true } }
      })
      UI.message("Uploaded #{file_name}")
      uploaded_ids[reservation["id"]] = file_name
    end

    deadline = Time.now + 600
    pending = uploaded_ids.dup
    until pending.empty? || Time.now > deadline
      sleep(15)
      pending.keys.each do |id|
        attributes = client.get("v1/appAssetLibraryImages/#{id}").body["data"]["attributes"]
        state = attributes["state"]
        next if ["AWAITING_UPLOAD", "UPLOAD_COMPLETE"].include?(state)

        if state == "FAILED"
          UI.error("#{pending[id]}: FAILED #{attributes['stateDetails']}")
        else
          UI.success("#{pending[id]}: #{state}")
        end
        pending.delete(id)
      end
    end

    pending.each_value { |file_name| UI.important("#{file_name}: still processing, check App Store Connect") }
  end

end
