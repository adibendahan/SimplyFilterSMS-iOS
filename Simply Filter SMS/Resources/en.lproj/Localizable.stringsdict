<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>autoFilter_countryAllowlist_section_allowed</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@countries@</string>
        <key>countries</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>Allowed Country</string>
            <key>other</key>
            <string>Allowed Countries</string>
        </dict>
    </dict>
    <key>autoFilter_countryAllowlist_section_blocked</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@countries@</string>
        <key>countries</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>Blocked Country</string>
            <key>other</key>
            <string>Blocked Countries</string>
        </dict>
    </dict>
    <key>general_active_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@filters@</string>
        <key>filters</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>zero</key>
            <string>No filters</string>
            <key>one</key>
            <string>1 filter</string>
            <key>other</key>
            <string>%ld filters</string>
        </dict>
    </dict>

    <key>reportingExtension_selectedMessage</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>Selected Message</string>
            <key>other</key>
            <string>Selected Messages</string>
        </dict>
    </dict>
    <key>reportingExtension_classify</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>How would you like to classify it?</string>
            <key>other</key>
            <string>How would you like to classify them?</string>
        </dict>
    </dict>
    <key>communityLists_active_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@lists@</string>
        <key>lists</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>zero</key>
            <string>Off</string>
            <key>one</key>
            <string>1 list on</string>
            <key>other</key>
            <string>%ld lists on</string>
        </dict>
    </dict>

    <key>stayReachable_addFilters</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@filters@</string>
        <key>filters</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>zero</key>
            <string>Add Allowed Texts</string>
            <key>one</key>
            <string>Add 1 Allowed Text</string>
            <key>other</key>
            <string>Add %ld Allowed Texts</string>
        </dict>
    </dict>

    <key>autoFilter_languagesOn</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@languages@</string>
        <key>languages</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>zero</key>
            <string>AI Filtering is off</string>
            <key>one</key>
            <string>On for 1 language</string>
            <key>other</key>
            <string>On for %ld languages</string>
        </dict>
    </dict>

    <key>autoFilter_ruleCount</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@rules@</string>
        <key>rules</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>1 rule</string>
            <key>other</key>
            <string>%ld rules</string>
        </dict>
    </dict>

    <key>autoFilter_rulesFromLanguages</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%1$#@rules@ in %2$#@languages@</string>
        <key>rules</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>1 rule</string>
            <key>other</key>
            <string>%ld rules</string>
        </dict>
        <key>languages</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>1 language</string>
            <key>other</key>
            <string>%ld languages</string>
        </dict>
    </dict>
</dict>
</plist>
