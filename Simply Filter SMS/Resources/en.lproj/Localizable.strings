//MARK: Help View
"faq_subtitle" = "Can't find your answer? Email or open a GitHub issue.";
"faq_section" = "FAQ";
"help_faq_title" = "All Questions";
"help_faq_caption" = "Filtering, privacy, Community Lists and more.";
"help_getStarted" = "Get Started";
"help_siriShortcuts" = "Siri & Shortcuts";
"help_shortcuts_caption" = "See all the actions, and use them in your own shortcuts.";
"help_enableFiltering_title" = "Enable Filtering";
"help_enableFiltering_caption" = "Required in iOS Settings before unknown SMS can be filtered.";
"help_enableReporting_title" = "Enable Reporting Extension";
"help_enableReporting_caption" = "Optional. Report from a thread in Messages to help improve AI Filtering.";
"faq_howItWorks_question" = "How does message filtering work?";
"faq_howItWorks_answer" = "When you get an SMS from a number that isn't in Contacts, Simply Filter SMS checks it, and the first match decides:\n\n• Texts on your **Allow List** always get through.\n• **Block All Unknown**, if on, sends everything else to Junk.\n• **Smart Filters**, your **Block List**, blocked languages, **AI Filtering** and **Community Lists** can send it to Junk, Transactions or Promotions.\n• If nothing matches, the message is delivered normally.\n\niMessage and senders in Contacts are never sent to the app.";
"faq_privacy_question" = "Are my messages exposed to the app developer?";
"faq_privacy_answer" = "No. Simply Filter SMS doesn't collect any information, and every message is checked on your device. A message is only sent if you report it yourself, and then only that one.";
"faq_iMessage_question" = "What about iMessages and messages from my contacts?";
"faq_iMessage_answer" = "Apple doesn't pass them to any filtering app, so they can't be filtered, and they stay completely private.";
"faq_whereFiltered_question" = "Where are the filtered messages?";
"faq_whereFiltered_answer" = "In the Messages app, in the **Junk**, **Transactions** or **Promotions** folder. Nothing is deleted, so you can read them anytime.";
"faq_folders_question" = "What's the difference between Junk, Transactions and Promotions?";
"faq_folders_answer" = "Not much. You can send any filter to any of them, and iOS doesn't let apps change them. Only messages in Junk arrive silently, without a notification.";
"faq_ai_question" = "How does AI Filtering work?";
"faq_ai_answer" = "Turn on AI Filtering for the languages you get texts in. It uses AI-made keyword lists to send spam to Junk, Transactions or Promotions, and the lists update by themselves. Messages are checked on your device, and your own filters still apply.";
"faq_notFiltering_question" = "Why aren't my messages being filtered?";
"faq_notFiltering_answer" = "Usually one of these:\n\n• Simply Filter SMS isn't selected as the filter in iOS Settings.\n• The thread is **iMessage** (blue bubbles), not SMS. Apple doesn't let any app filter those.\n• The sender is in **Contacts**. iOS skips filtering for them.\n\nOn the home screen, tap the ••• button at the top right, then **Filter Tools**, then **Test Your Filters**, and paste the sender and message. The test runs in the app even when filtering is off, so it can show filtered while Messages still delivers. If Simply Filter SMS is enabled in iOS Settings and the test still says it should have been filtered, email me.";
"faq_smartFilters_question" = "What are Smart Filters?";
"faq_smartFilters_answer" = "**Smart Filters** on the home screen catch common spam: links, email senders, emojis, short senders, and senders with letters in their name. Matches go to Junk. **Block All Unknown** is the strongest: it sends every unknown sender to Junk unless it's on your Allow List.";
"faq_allowByCountry_question" = "What is Allow by Country?";
"faq_allowByCountry_answer" = "A Smart Filter that lets through SMS from the country codes you choose, such as +1 or +972. Numbers from other countries go to Junk. Senders without a country code aren't checked.";
"faq_filterTester_question" = "How do I test my filters?";
"faq_filterTester_answer" = "On the home screen, tap the ••• button at the top right, then **Filter Tools**, then **Test Your Filters**. Type a sender and message. The result updates as you type. Leave the sender blank to test the body only.";
"faq_shareFilters_question" = "Can I share my filters?";
"faq_shareFilters_answer" = "On the home screen, tap the ••• button at the top right, then **Filter Tools**, then **Export Filters**, and send the file. On the other device, use **Import Filters** to add them. Filters that already exist there are skipped. Nothing is overwritten or deleted. To share them with everyone, publish them as a Community List.";
"faq_communityLists_question" = "What are Community Lists?";
"faq_communityLists_answer" = "Filter lists made and shared by other people. On the home screen, open **Community Lists** to turn on a featured list, or tap **Subscribe from URL** and paste a link someone shared. Lists you turn on update by themselves. Subscribe only to lists you trust. To share your own, tap **Create a List**.";
"faq_report_question" = "How do I help improve AI Filtering?";
"faq_report_answer" = "On the home screen, tap the ••• button at the top right, then **Filter Tools**:\n\n• **Report Message** reports a text as Junk or Not Junk.\n• **Improve AI Filtering** sets up reporting from a thread in Messages.\n\nReports train the AI that makes the lists. Only the message you report is sent, and filtering on your device still happens locally.";
"faq_stayReachable_question" = "What is Stay Reachable?";
"faq_stayReachable_answer" = "A courier, a clinic or a neighbor may text you from a number you don't know. Tap **+** at the top of the home screen, then **Stay Reachable**, and add your name and street. Texts that mention them always get through.";
"faq_siriShortcuts_question" = "Can I use Siri and Shortcuts?";
"faq_siriShortcuts_answer" = "Yes. Ask Siri to add or remove a filter, check a message, block a language or update the lists. For example: “Add a filter in Simply Filter SMS”. The same actions are in the Shortcuts app for your own shortcuts.";
"faq_iCloudSync_question" = "Do my filters sync to my other devices?";
"faq_iCloudSync_answer" = "Yes. With iCloud on, your filters, Smart Filters and lists sync to every device signed in to the same Apple Account. They go to your iCloud, never to the developer.";
"help_deny" = "Add texts that will cause a message to be marked as spam. You can also choose the specific folder you want the message to be stored in.";
"help_allow" = "Add texts that will cause a message to be marked as valid. It is recommended to add unique identifying texts like your name here. Texts on this list have the highest priority when filtering a message.";

