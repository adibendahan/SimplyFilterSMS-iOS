            <key>other</key>
            <string>%ld כללים</string>
        </dict>
        <key>languages</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>בשפה אחת</string>
            <key>two</key>
            <string>בשתי שפות</string>
            <key>many</key>
