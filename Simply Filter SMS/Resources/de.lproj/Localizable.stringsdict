<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>autoFilter_countryAllowlist_section_allowed</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@countries@</string>
        <key>countries</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>Erlaubtes Land</string>
            <key>other</key>
            <string>Erlaubte Länder</string>
        </dict>
    </dict>
    <key>autoFilter_countryAllowlist_section_blocked</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@countries@</string>
        <key>countries</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>Gesperrtes Land</string>
            <key>other</key>
            <string>Gesperrte Länder</string>
        </dict>
    </dict>
    <key>general_active_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@filters@</string>
        <key>filters</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>zero</key>
            <string>Keine Filter</string>
            <key>one</key>
            <string>1 Filter</string>
            <key>other</key>
            <string>%ld Filter</string>
        </dict>
    </dict>

    <key>reportingExtension_selectedMessage</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>Ausgewählte Nachricht</string>
            <key>other</key>
            <string>Ausgewählte Nachrichten</string>
        </dict>
    </dict>
    <key>reportingExtension_classify</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>Wie möchtest du sie klassifizieren?</string>
            <key>other</key>
            <string>Wie möchtest du sie klassifizieren?</string>
        </dict>
    </dict>
    <key>communityLists_active_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@lists@</string>
        <key>lists</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>zero</key>
            <string>Keine aktiv</string>
            <key>one</key>
            <string>1 Liste aktiv</string>
            <key>other</key>
            <string>%ld Listen aktiv</string>
        </dict>
    </dict>

    <key>stayReachable_addFilters</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@filters@</string>
        <key>filters</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>zero</key>
            <string>Erlaubte Texte hinzufügen</string>
            <key>one</key>
            <string>1 erlaubten Text hinzufügen</string>
            <key>other</key>
            <string>%ld erlaubte Texte hinzufügen</string>
        </dict>
    </dict>

    <key>autoFilter_languagesOn</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@languages@</string>
        <key>languages</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>zero</key>
            <string>KI-Filterung ist aus</string>
            <key>one</key>
            <string>Aktiv für 1 Sprache</string>
            <key>other</key>
            <string>Aktiv für %ld Sprachen</string>
        </dict>
    </dict>

    <key>autoFilter_ruleCount</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@rules@</string>
        <key>rules</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>1 Regel</string>
            <key>other</key>
            <string>%ld Regeln</string>
        </dict>
    </dict>

    <key>autoFilter_rulesFromLanguages</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%1$#@rules@ in %2$#@languages@</string>
        <key>rules</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>1 Regel</string>
            <key>other</key>
            <string>%ld Regeln</string>
        </dict>
        <key>languages</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>ld</string>
            <key>one</key>
            <string>1 Sprache</string>
            <key>other</key>
            <string>%ld Sprachen</string>
        </dict>
    </dict>
</dict>
</plist>
