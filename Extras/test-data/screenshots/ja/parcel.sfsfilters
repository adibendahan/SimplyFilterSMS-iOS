  "filters": [
    {
      "case": "insensitive",
      "folder": "junk",
      "matching": "contains",
      "target": "body",
      "text": "customs fee",
      "type": "deny"
    }
  ],
  "format": "simply-filter-sms-filters",
  "homepage": "https://github.com/philter-lists/parcel-scams",
  "locale": "ja-JP",
  "name": "配送詐欺ブロック",
  "version": 2
}
