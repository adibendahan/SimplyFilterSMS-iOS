      "case": "insensitive",
      "folder": "promotion",
      "matching": "contains",
      "target": "body",
      "text": "coupon",
      "type": "deny"
    }
  ],
  "format": "simply-filter-sms-filters",
  "homepage": "https://github.com/markd-deals/store-deals",
  "locale": "ar-SA",
  "name": "عروض المتاجر",
  "version": 2
}
