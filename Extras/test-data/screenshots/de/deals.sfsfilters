{
  "appVersion": "4.0.0",
  "author": "M. Preis",
  "description": "Verschiebt Werbung und Gutscheine von Shops nach „Werbung“.",
  "exportedAt": "2026-11-16T00:00:00Z",
  "filters": [
    {
      "case": "insensitive",
      "folder": "promotion",
      "matching": "contains",
      "target": "body",
      "text": "coupon",
      "type": "deny"
    }
  ],
  "format": "simply-filter-sms-filters",
  "homepage": "https://github.com/markd-deals/store-deals",
  "locale": "de-DE",
  "name": "Shop-Angebote",
  "version": 2
}
