{
  "appVersion": "4.0.0",
  "author": "Phil Ter",
  "description": "Blocks fake parcel, delivery and customs-fee texts.",
  "exportedAt": "2026-11-16T00:00:00Z",
  "filters": [
    {
      "case": "insensitive",
      "folder": "junk",
      "matching": "contains",
      "target": "body",
      "text": "customs fee",
      "type": "deny"
    }
  ],
  "format": "simply-filter-sms-filters",
  "homepage": "https://github.com/philter-lists/parcel-scams",
  "locale": "en-US",
  "name": "Delivery Scam Shield",
  "version": 2
}
