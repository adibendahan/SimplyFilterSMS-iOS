{
  "appVersion": "4.0.0",
  "author": "Mark.D",
  "description": "Moves store promotions and coupons to Promotions.",
  "exportedAt": "2026-11-16T00:00:00Z",
  "filters": [
    {
      "case": "insensitive",
      "folder": "promotion",
      "matching": "contains",
      "target": "body",
      "text": "coupon",
      "type": "deny"
    }
  ],
  "format": "simply-filter-sms-filters",
  "homepage": "https://github.com/markd-deals/store-deals",
  "locale": "en-US",
  "name": "Store Deals",
  "version": 2
}
