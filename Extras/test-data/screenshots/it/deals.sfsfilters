{
  "appVersion": "4.0.0",
  "author": "S. Conti",
  "description": "Sposta promozioni e coupon dei negozi in Promozioni.",
  "exportedAt": "2026-11-16T00:00:00Z",
  "filters": [
    {
      "case": "insensitive",
      "folder": "promotion",
      "matching": "contains",
      "target": "body",
      "text": "coupon",
      "type": "deny"
    }
  ],
  "format": "simply-filter-sms-filters",
  "homepage": "https://github.com/markd-deals/store-deals",
  "locale": "it-IT",
  "name": "Offerte dei negozi",
  "version": 2
}
