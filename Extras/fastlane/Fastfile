default_platform(:ios)

platform :ios do

  def api_key
    app_store_connect_api_key(
      key_id: "25D6M24FR5",
      issuer_id: "1ce4be2f-095e-46f8-9565-6893ad621877",
      key_filepath: "~/.appstoreconnect/private_keys/AuthKey_25D6M24FR5.p8"
    )
  end

  desc "Upload the framed screenshots (screenshots/latest/store, or path:screenshots/<version>/store) to App Store Connect"
  lane :upload_screenshots do |options|
    path = File.realpath(options[:path] || "screenshots/latest/store")
    UI.message("Uploading #{path}")
    upload_to_app_store(
      api_key: api_key,
      screenshots_path: path,
      skip_metadata: true,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Download existing metadata from App Store Connect"
  lane :download_metadata do
    upload_to_app_store(
      api_key: api_key,
      metadata_path: "fastlane/metadata",
      skip_screenshots: true,
      skip_binary_upload: true,
      download_only: true
    )
  end

  desc "Upload metadata to App Store Connect"
  lane :upload_metadata do
    upload_to_app_store(
      api_key: api_key,
      metadata_path: "fastlane/metadata",
      skip_screenshots: true,
      skip_binary_upload: true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload creative assets (fastlane/creative_assets/*.png, or files:a.png,b.png) to the App Asset Library"
  lane :upload_creative_assets do |options|
    api_key
    client = Spaceship::ConnectAPI.client.tunes_request_client
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    UI.user_error!("App not found") unless app

    library_id = client.get("v1/apps/#{app.id}/assetLibrary").body["data"]["id"]

    existing_names = client.get("v1/appAssetLibraries/#{library_id}/images", { limit: 200 })
      .all_pages
      .flat_map { |page| page.body["data"] }
      .reject { |image| image["attributes"]["state"] == "FAILED" }
      .map { |image| image["attributes"]["fileName"] }

    assets_folder = File.join(FastlaneCore::FastlaneFolder.path, "creative_assets")
    paths = Dir[File.join(assets_folder, "*.png")].sort
    if options[:files]
      requested = options[:files].split(",").map(&:strip)
      paths = paths.select { |path| requested.include?(File.basename(path)) }
      UI.user_error!("No matching files in #{assets_folder}") if paths.empty?
    end

    uploaded_ids = {}
    paths.each do |path|
      file_name = File.basename(path)
      if existing_names.include?(file_name)
        UI.important("Skipping #{file_name}: already in the library")
        next
      end

      bytes = File.binread(path)
      reservation = client.post("v1/appAssetLibraryImages", {
        data: {
          type: "appAssetLibraryImages",
          attributes: {
            fileName: file_name,
            fileSize: bytes.bytesize,
            category: "CREATIVE_ASSETS",
            referenceName: File.basename(path, ".png")
          },
          relationships: {
            assetLibrary: { data: { type: "appAssetLibraries", id: library_id } }
          }
        }
      }).body["data"]

      Spaceship::ConnectAPI::FileUploader.upload(reservation["attributes"]["uploadOperations"], bytes)
      client.patch("v1/appAssetLibraryImages/#{reservation['id']}", {
        data: { type: "appAssetLibraryImages", id: reservation["id"], attributes: { uploaded: true } }
      })
      UI.message("Uploaded #{file_name}")
      uploaded_ids[reservation["id"]] = file_name
    end

    deadline = Time.now + 600
    pending = uploaded_ids.dup
    until pending.empty? || Time.now > deadline
      sleep(15)
      pending.keys.each do |id|
        attributes = client.get("v1/appAssetLibraryImages/#{id}").body["data"]["attributes"]
        state = attributes["state"]
        next if ["AWAITING_UPLOAD", "UPLOAD_COMPLETE"].include?(state)

        if state == "FAILED"
          UI.error("#{pending[id]}: FAILED #{attributes['stateDetails']}")
        else
          UI.success("#{pending[id]}: #{state}")
        end
        pending.delete(id)
      end
    end

    pending.each_value { |file_name| UI.important("#{file_name}: still processing, check App Store Connect") }
  end

  desc "Set the uploaded search-3x2-<lang>-<suffix>.png images as a version's search results banner"
  lane :place_search_banner do |options|
    UI.user_error!("Pass the app version and the uploaded images' suffix: fastlane place_search_banner version:4.0.2 suffix:4.0.2") unless options[:version] && options[:suffix]
    api_key
    client = Spaceship::ConnectAPI.client.tunes_request_client
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    UI.user_error!("App not found") unless app

    languages = {
      "en-US" => "en", "he" => "he", "de-DE" => "de", "es-ES" => "es", "fr-FR" => "fr", "it" => "it",
      "pt-BR" => "pt-BR", "ar-SA" => "ar", "ja" => "ja", "ko" => "ko", "zh-Hans" => "zh-Hans"
    }
    only = options[:locales] ? options[:locales].split(",").map(&:strip) : nil

    version = client.get("v1/apps/#{app.id}/appStoreVersions", { "filter[versionString]" => options[:version] }).body["data"].first
    UI.user_error!("Version #{options[:version]} not found in App Store Connect") unless version

    library_id = client.get("v1/apps/#{app.id}/assetLibrary").body["data"]["id"]
    images = client.get("v1/appAssetLibraries/#{library_id}/images", { limit: 200 })
      .all_pages
      .flat_map { |page| page.body["data"] }
      .reject { |image| image["attributes"]["state"] == "FAILED" }

    localizations = client.get("v1/appStoreVersions/#{version['id']}/appStoreVersionLocalizations", { limit: 50 }).body["data"]
    localizations.each do |localization|
      locale = localization["attributes"]["locale"]
      next if only && !only.include?(locale)

      code = languages[locale]
      unless code
        UI.important("#{locale}: no banner for this language, skipped")
        next
      end

      file_name = "search-3x2-#{code}-#{options[:suffix]}.png"
      image = images.find { |candidate| candidate["attributes"]["fileName"] == file_name }
      unless image
        UI.error("#{locale}: #{file_name} is not in the asset library; upload it first")
        next
      end

      placements = client.get("v1/appStoreVersionLocalizations/#{localization['id']}/placements", { limit: 200, include: "image" }).body["data"]
      current = placements.select { |placement| placement["attributes"]["placementType"] == "APP_STORE_SEARCH_RESULTS_ASSET" }
      if current.any? { |placement| placement.dig("relationships", "image", "data", "id") == image["id"] }
        UI.message("#{locale}: already shows #{file_name}")
        next
      end

      place = lambda do |image_id|
        client.post("v1/appAssetLibraryPlacements", {
          data: {
            type: "appAssetLibraryPlacements",
            attributes: { placementType: "APP_STORE_SEARCH_RESULTS_ASSET", placementGroup: "DEFAULT_PROFILE" },
            relationships: {
              image: { data: { type: "appAssetLibraryImages", id: image_id } },
              appStoreVersionLocalization: { data: { type: "appStoreVersionLocalizations", id: localization["id"] } }
            }
          }
        })
      end

      old_image_id = current.first&.dig("relationships", "image", "data", "id")
      current.each { |placement| client.delete("v1/appAssetLibraryPlacements/#{placement['id']}") }
      begin
        place.call(image["id"])
        UI.success("#{locale}: now shows #{file_name}")
      rescue => error
        UI.error("#{locale}: App Store Connect refused #{file_name}: #{error.message}")
        if old_image_id
          place.call(old_image_id)
          UI.important("#{locale}: put the previous banner back")
        end
      end
    end
  end

end
